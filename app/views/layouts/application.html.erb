<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Todo Management UI" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Todo Management UI">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-screen bg-gray-100 text-gray-900 antialiased">
    <main class="mx-auto max-w-3xl px-4 py-8 sm:py-12">
      <% if notice.present? %>
        <p role="status" data-turbo-temporary class="mb-4 rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p role="alert" data-turbo-temporary class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
